profile: default
---
# ladulas-relay, run locally against the real Apple push service (§11, M9).
#
#	ttrun -- go run ./cmd/ladulas-relay
#
# The production host, not the sandbox, and that is not a mistake: a TestFlight
# build is signed for distribution, so its device tokens are production tokens
# and the sandbox answers BadDeviceToken for every one of them. CI and
# TestFlight are the only path onto a device here.
LISTEN_ADDR=:8443
STATE_FILE=./.relay-devices.json
APNS_HOST=https://api.push.apple.com
APNS_TOPIC=nu.wetterberg.ladulas
APNS_KEY_ID=VR4L23STQ8
APNS_TEAM_ID=P65PA5N8E9
# The .p8 itself. A reference, never a value: this file is committed, and the
# key it names is the one thing that can send a notification to every phone
# running this build.
APNS_KEY={{vault://${base_path}/${vault_prefix}/ladulas-apns.auth-key}}
